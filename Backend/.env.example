# Database & Security
MYSQL_URI=mysql://username:password@localhost:3306/database_name

JWT_SECRET=your_jwt_secret_key_here

# Admin Panel Credentials
ADMIN_EMAIL=admin@docconnect.com
ADMIN_PASSWORD=your_admin_password_here

# Cloudinary (for profile pictures upload)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# LLM APIs (Gemini or Groq)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Google Calendar OAuth 2.0 (for calendar sync)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/user/google-callback

# Email Notification Server (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=DocConnect Support
